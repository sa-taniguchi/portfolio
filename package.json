{
	"name": "t.s-portfolio",
	"type": "module",
	"private": true,
	"engines": {
		"node": "22.21.1",
		"npm": "10.9.4"
	},
	"volta": {
		"node": "22.21.1"
	},
	"scripts": {
		"clean": "nuxi cleanup",
		"fresh": "rm -rf .nuxt .output node_modules && npm install && npm run dev",
		"build": "nuxt build",
		"dev": "nuxt dev --dotenv .env.local",
		"stg": "npm run lint && nuxt build --dotenv .env.staging",
		"prod": "npm run lint && nuxt build --dotenv .env.production",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead",
		"Safari >= 15.4"
	],
	"dependencies": {
		"@nuxt/eslint": "^1.15.2",
		"fuse.js": "^7.2.0",
		"nuxt": "^4.1.3",
		"vue": "^3.5.25",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@nuxtjs/google-fonts": "^3.2.0",
		"@pinia/nuxt": "^0.11.3",
		"@studio-freight/lenis": "^1.0.42",
		"@types/node": "^25.3.5",
		"@vercel/edge": "^1.2.2",
		"gsap": "^3.14.2",
		"pinia": "^3.0.4",
		"sass": "^1.97.3",
		"sass-embedded": "^1.97.3",
		"swiper": "^12.1.3",
		"zod": "^4.3.6"
	}
}
